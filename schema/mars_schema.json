{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MARS Schema v0.1",
  "type": "object",
  "properties": {
    "isolates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "isolate_id", "source_dataset", "loaded_at", "ncbi_taxonomy_id",
          "organism_name_standard", "gram_type", "country_iso", "year_collected",
          "has_genotype_data"
        ],
        "properties": {
          "isolate_id": { "type": "string" },
          "source_dataset": { "type": "string" },
          "loaded_at": { "type": "string", "format": "date-time" },
          "ncbi_taxonomy_id": { "type": "integer" },
          "organism_name_standard": { "type": "string" },
          "gram_type": { "type": "string", "enum": ["Gram-negative", "Gram-positive", "Fungal", "Mycobacteria", "Unknown"] },
          "organism_group": { "type": "string" },
          "country_iso": { "type": "string", "minLength": 2, "maxLength": 2 },
          "region_un_m49": { "type": "string" },
          "year_collected": { "type": "integer" },
          "specimen_type": { "type": "string" },
          "facility_type": { "type": "string" },
          "age_group": { "type": "string" },
          "gender": { "type": "string", "enum": ["M", "F", "Unknown"] },
          "nosocomial": { "type": "boolean" },
          "infection_type": { "type": "string" },
          "subtype": { "type": "string" },
          "has_genotype_data": { "type": "boolean" },
          "metadata": { "type": "object" }
        }
      }
    },
    "mic_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "isolate_id", "source_dataset", "chembl_id", "drug_name_standard",
          "mic_numeric", "mic_qualifier"
        ],
        "properties": {
          "isolate_id": { "type": "string" },
          "source_dataset": { "type": "string" },
          "chembl_id": { "type": "string" },
          "drug_name_standard": { "type": "string" },
          "drug_class": { "type": "string" },
          "aware_category": { "type": "string", "enum": ["Access", "Watch", "Reserve", "Unknown"] },
          "mic_numeric": { "type": "number" },
          "mic_qualifier": { "type": "string", "enum": ["=", ">", "<", ">=", "<="] },
          "interpretation_raw": { "type": "string" },
          "interpretation_standard": { "type": "string", "enum": ["S", "I", "R", "Unknown"] },
          "breakpoint_system": { "type": "string", "enum": ["CLSI", "EUCAST", "Unknown"] },
          "breakpoint_version": { "type": "string" }
        }
      }
    },
    "genotype_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "isolate_id", "source_dataset"
        ],
        "properties": {
          "isolate_id": { "type": "string" },
          "source_dataset": { "type": "string" },
          "gene_aro_id": { "type": "string" },
          "gene_name_standard": { "type": "string" },
          "phenotypic_class": { "type": "string" },
          "betalactamase_status": { "type": "string", "enum": ["POS", "NEG", "Unknown"] },
          "hgvs_notation": { "type": "string" },
          "variant_type": { "type": "string", "enum": ["nucleotide", "amino_acid", "Unknown"] },
          "raw_notation": { "type": "string" }
        }
      }
    },
    "crosswalk_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_dataset", "crosswalk_type", "raw_value", "mapped_identifier",
          "mapped_name", "confidence", "mapped_at"
        ],
        "properties": {
          "source_dataset": { "type": "string" },
          "crosswalk_type": { "type": "string", "enum": ["organism", "drug", "gene", "country"] },
          "raw_value": { "type": "string" },
          "mapped_identifier": { "type": "string" },
          "mapped_name": { "type": "string" },
          "confidence": { "type": "string", "enum": ["exact", "fuzzy", "manual", "unknown"] },
          "mapped_at": { "type": "string", "format": "date-time" },
          "mapped_by": { "type": "string" }
        }
      }
    }
  }
}
